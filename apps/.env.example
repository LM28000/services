# =====================================================================
# Secrets for /docker/services/apps/docker-compose.yml
# compose-sur-disque migration. KEEP chmod 600. Do NOT commit.
#
# This file is the canonical secret store AND is split into the
# per-service env_file fragments below so that each container receives
# the exact variable names its image expects (no ${} interpolation).
# Each service uses its own env_file (secrets.<svc>.env) declared next
# to this one; values are kept in sync here for reference.
# =====================================================================

# nextcloud (app + cron + db share these DB creds) -> secrets.nextcloud.env
#   MYSQL_PASSWORD            (app/cron/db)
#   MYSQL_ROOT_PASSWORD       (db only)

# vaultwarden -> secrets.vaultwarden.env
#   ADMIN_TOKEN

# mediawiki (app + db share these DB creds) -> secrets.mediawiki.env
#   MEDIAWIKI_DB_PASSWORD / MARIADB_PASSWORD
#   MARIADB_ROOT_PASSWORD    (db only)
